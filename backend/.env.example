GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ENVIRONMENT=development

# Provider routing: "groq" (cloud, faster, data leaves machine) or "local" (Ollama, private, slower)
VOKU_PROVIDER=groq

# Production CORS origins (comma-separated, e.g. https://voku.up.railway.app)
CORS_ORIGINS=
