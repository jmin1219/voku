# Voku — Docker environment variables
# Copy to .env and fill in your API keys

# Required for chat (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for annotation extraction (Groq)
GROQ_API_KEY=gsk_your-key-here

# Provider: "groq" (cloud) or "local" (Ollama)
VOKU_PROVIDER=groq

# CORS origins for production (comma-separated, leave empty for permissive)
CORS_ORIGINS=
